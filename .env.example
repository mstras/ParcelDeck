# --- Required -------------------------------------------------------------
# 17TRACK API key: admin.17track.net -> Settings -> Security -> Access Key
TRACK17_API_KEY=

# --- Recommended ----------------------------------------------------------
# Public URL (via Pangolin). Used to show the webhook URL in the app.
PUBLIC_URL=https://parcels.strasserco.com

# Login for the web UI. Leave APP_PASSWORD empty to disable (NOT recommended if exposed via Pangolin).
APP_USERNAME=michael
APP_PASSWORD=
# How long you stay signed in (days)
SESSION_DAYS=30

# Notifications via Apprise — space/comma separated. Examples:
#   ntfy://ntfy.sh/my-parcels   pover://USER@TOKEN   tgram://BOT/CHAT   mailtos://user:pass@gmail.com
#   Full list: https://github.com/caronc/apprise/wiki
APPRISE_URLS=

# Which status changes trigger a notification
NOTIFY_ON=InTransit,AvailableForPickup,OutForDelivery,Delivered,DeliveryFailure,Exception

# --- Gmail import (optional) --------------------------------------------
# Needs 2-Step Verification on, then create an app password at
# https://myaccount.google.com/apppasswords  (16 characters; spaces are fine)
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
# auto   = confident matches (UPS 1Z…, USPS 92/94…, AliExpress LP…, Amazon TBA…, carrier links,
#          "Tracking number: …") are added automatically; ambiguous ones wait for you to approve
# review = everything waits for approval
# off    = disabled
EMAIL_MODE=auto
EMAIL_POLL_MINUTES=15
# How far back to search. Keep it short: every imported number uses 1 17TRACK quota.
EMAIL_LOOKBACK_DAYS=7

# --- Tuning ---------------------------------------------------------------
# Background refresh interval (minutes, min 5). Refreshing costs no quota.
POLL_MINUTES=60
# Verify 17TRACK webhook signatures (sha256(body + "/" + key))
WEBHOOK_VERIFY=true
TZ=America/New_York
